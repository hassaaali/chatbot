# Together AI API Configuration
TOGETHER_API_KEY=your_together_api_key_here
TOGETHER_API_URL=https://api.together.xyz/v1/chat/completions

# Legal-specific LLM configuration - Optimized for legal analysis
LLM_MODEL=meta-llama/Llama-2-70b-chat-hf
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=3000
LLM_TOP_P=0.9

# Vector Store Configuration
CHROMA_DB_PATH=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Document Processing - Optimized for legal documents
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_RETRIEVAL_RESULTS=4

# Memory optimization settings
MAX_FILE_SIZE=10485760
BATCH_SIZE=3

# Together AI specific settings
TOGETHER_REQUEST_TIMEOUT=180
TOGETHER_MAX_RETRIES=3